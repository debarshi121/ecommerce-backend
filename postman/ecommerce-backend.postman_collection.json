                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"jane.doe@example.com\",\n  \"password\": \"SuperSecret123\",\n  \"deviceName\": \"Postman\",\n  \"type\": \"password\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "description": "`type` selects the auth provider (`password` or `otp`). For `otp`, request one via **Auth > Request OTP** first and pass it as `otp`.",
                "auth": {
                  "type": "noauth"
                }
              },
              "response": [],
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
