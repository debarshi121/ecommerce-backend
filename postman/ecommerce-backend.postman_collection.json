                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"sku\": \"SKU-TSHIRT-001\",\n  \"name\": \"Classic Cotton T-Shirt\",\n  \"shortDescription\": \"100% cotton, unisex fit\",\n  \"description\": \"A soft, breathable everyday t-shirt made from 100% combed cotton.\",\n  \"categoryId\": \"{{categoryId}}\",\n  \"brandId\": \"{{brandId}}\",\n  \"metadata\": {\n    \"color\": \"white\",\n    \"material\": \"cotton\"\n  },\n  \"images\": [\n    {\n      \"imageUrl\": \"https://example.com/images/tshirt-front.png\",\n      \"altText\": \"T-shirt front view\"\n    }\n  ]\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "description": "`slug` is generated server-side from `name` — do not send it. `categoryId`/`brandId` are optional but must reference existing rows if provided."
              },
              "response": [],
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code === 201) {",
                      "  const json = pm.response.json();",
                      "  if (json.id) pm.collectionVariables.set('productId', json.id);",
                      "  if (json.slug) pm.collectionVariables.set('productSlug', json.slug);",
                      "  if (Array.isArray(json.images) && json.images.length) {",
                      "    pm.collectionVariables.set('imageId', json.images[json.images.length - 1].id);",
                      "  }",
                      "}"
                    ]
                  }
                }
              ]
            },
